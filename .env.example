# Copy to .env and fill in. Never commit the real .env.

# Signs the JWTs handed out by POST /api/login. Minimum 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# How long an issued token stays valid.
TOKEN_TTL_MINUTES=60

# Where the server listens.
HOST=127.0.0.1
PORT=8080

# SQLite for now. Swapping engines later means a new db::Store implementation
# plus this URL, e.g. postgres://user:pass@localhost/casino.
DATABASE_URL=sqlite://data/casino.db

# Shown on the status page.
APP_ENV=development

# Directory holding the login and status pages.
STATIC_DIR=static

# Log filter, e.g. debug, or info,sqlx=warn
RUST_LOG=info,sqlx=warn
